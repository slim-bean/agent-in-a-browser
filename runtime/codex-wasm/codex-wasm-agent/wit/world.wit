package codex:agent@0.1.0;

/// Shell execution interface — the host (browser SharedWorker) runs commands
/// via its MCP shell tool infrastructure and returns captured output.
interface shell-exec {
    /// Environment for command execution.
    record exec-env {
        /// Working directory.
        cwd: string,
        /// Environment variables (key-value pairs).
        vars: list<tuple<string, string>>,
    }

    /// Result of a command execution.
    record exec-result {
        /// Exit code (0 = success).
        exit-code: s32,
        /// Captured stdout bytes.
        stdout: list<u8>,
        /// Captured stderr bytes.
        stderr: list<u8>,
    }

    /// Execute a command synchronously and return captured output.
    /// The host runs the command in its sandbox and blocks (via JSPI)
    /// until the command completes or times out.
    exec: func(
        program: string,
        args: list<string>,
        env: exec-env,
        stdin: option<list<u8>>,
        timeout-ms: option<u32>,
    ) -> result<exec-result, string>;
}

/// Codex agent world — drop-in replacement for the existing headless-agent.
/// Exports the same WIT interface so the frontend needs zero changes.
world codex-agent {
    // WASI imports for system capabilities
    import wasi:io/error@0.2.9;
    import wasi:io/poll@0.2.9;
    import wasi:io/streams@0.2.9;
    import wasi:http/types@0.2.9;
    import wasi:http/outgoing-handler@0.2.9;
    import wasi:clocks/monotonic-clock@0.2.9;
    import wasi:clocks/wall-clock@0.2.9;
    import wasi:random/insecure-seed@0.2.9;
    import wasi:filesystem/types@0.2.9;
    import wasi:filesystem/preopens@0.2.9;

    // Shell execution — routes to host sandbox
    import shell-exec;

    // Agent configuration (matches headless-agent exactly)
    record mcp-server-config {
        url: string,
        name: option<string>,
    }

    record provider-info {
        id: string,
        name: string,
        default-base-url: option<string>,
    }

    record model-info {
        id: string,
        name: string,
    }

    record agent-config {
        provider: string,
        model: string,
        api-key: string,
        base-url: option<string>,
        preamble: option<string>,
        preamble-override: option<string>,
        mcp-servers: option<list<mcp-server-config>>,
        max-turns: option<u32>,
    }

    record message {
        role: message-role,
        content: string,
    }

    enum message-role {
        user,
        assistant,
    }

    record tool-result-data {
        name: string,
        output: string,
        is-error: bool,
    }

    record task-info {
        id: string,
        name: string,
        description: string,
    }

    record task-update-info {
        id: string,
        status: string,
        progress: option<u32>,
    }

    record task-complete-info {
        id: string,
        success: bool,
        output: option<string>,
    }

    record model-loading-progress {
        text: string,
        progress: f32,
    }

    variant agent-event {
        stream-start,
        stream-chunk(string),
        stream-complete(string),
        stream-error(string),
        tool-call(string),
        tool-result(tool-result-data),
        plan-generated(string),
        task-start(task-info),
        task-update(task-update-info),
        task-complete(task-complete-info),
        model-loading(model-loading-progress),
        ready,
    }

    type agent-handle = u32;

    // Agent lifecycle
    export create: func(config: agent-config) -> result<agent-handle, string>;
    export destroy: func(handle: agent-handle);

    // Streaming API
    export send-message: func(handle: agent-handle, message: string) -> result<_, string>;
    export poll: func(handle: agent-handle) -> option<agent-event>;
    export cancel: func(handle: agent-handle);

    // Plan/Execute workflow
    export plan: func(handle: agent-handle, message: string) -> result<_, string>;
    export execute: func(handle: agent-handle) -> result<_, string>;

    // History management
    export get-history: func(handle: agent-handle) -> list<message>;
    export clear-history: func(handle: agent-handle);

    // Provider/Model discovery
    export list-providers: func() -> list<provider-info>;
    export list-models: func(provider-id: string) -> list<model-info>;
    export fetch-models: func(
        provider-id: string,
        api-key: string,
        base-url: option<string>
    ) -> result<list<model-info>, string>;
}
