[submodule "git-cli-wasm/patches/go-git"]
	path = git-cli-wasm/patches/go-git
	url = https://github.com/tjfontaine/go-git.git
	branch = wasip1-patches
[submodule "runtime/codex-upstream"]
	path = runtime/codex-upstream
	url = https://github.com/tjfontaine/codex.git
	branch = wasm32-wasip2
[submodule "stripe-cli-wasm"]
	path = stripe-cli-wasm
	url = https://github.com/tjfontaine/stripe-cli.git
	branch = wasip2-wasm-support
[submodule "tree-sitter-wasm/tree-sitter"]
	path = tree-sitter-wasm/tree-sitter
	url = https://github.com/tjfontaine/tree-sitter.git
	branch = wasip2
[submodule "tree-sitter-wasm/tree-sitter-bash"]
	path = tree-sitter-wasm/tree-sitter-bash
	url = https://github.com/tjfontaine/tree-sitter-bash.git
	branch = wasip2
[submodule "pyodide"]
	path = pyodide
	url = git@github.com:tjfontaine/pyodide.git
	branch = edge-agent-wasmfs
