package codex:tui@0.1.0;

/// Shell execution interface — the host (browser SharedWorker) runs commands
/// via its MCP shell tool infrastructure and returns captured output.
interface shell-exec {
    /// Environment for command execution.
    record exec-env {
        /// Working directory.
        cwd: string,
        /// Environment variables (key-value pairs).
        vars: list<tuple<string, string>>,
    }

    /// Result of a command execution.
    record exec-result {
        /// Exit code (0 = success).
        exit-code: s32,
        /// Captured stdout bytes.
        stdout: list<u8>,
        /// Captured stderr bytes.
        stderr: list<u8>,
    }

    /// Execute a command synchronously and return captured output.
    exec: func(
        program: string,
        args: list<string>,
        env: exec-env,
        stdin: option<list<u8>>,
        timeout-ms: option<u32>,
    ) -> result<exec-result, string>;
}

/// WebSocket interface — the host (browser) opens native WebSocket connections
/// and bridges text messages to/from WASM.
interface websocket {
    /// Open a WebSocket connection with optional subprotocols.
    /// Returns a handle on success.
    connect: func(url: string, protocols: list<string>) -> result<u32, string>;

    /// Send a text message on the WebSocket.
    send: func(handle: u32, data: string) -> result<_, string>;

    /// Receive the next text message. Returns none when the connection is closed.
    recv: func(handle: u32) -> result<option<string>, string>;

    /// Close the WebSocket connection.
    close: func(handle: u32);

    /// Check if the connection is closed.
    is-closed: func(handle: u32) -> bool;
}

/// Codex TUI world — runs the full Codex CLI terminal interface in WASM.
/// Replaces the old ratatui web-agent-tui with the upstream Codex TUI.
world codex-tui {
    // WASIP2 base imports for terminal I/O
    import wasi:io/error@0.2.9;
    import wasi:io/poll@0.2.9;
    import wasi:io/streams@0.2.9;
    import wasi:cli/stdin@0.2.9;
    import wasi:cli/stdout@0.2.9;
    import wasi:cli/stderr@0.2.9;
    import wasi:cli/environment@0.2.9;
    import wasi:cli/exit@0.2.9;
    import wasi:cli/terminal-input@0.2.9;
    import wasi:cli/terminal-output@0.2.9;
    import wasi:cli/terminal-stdin@0.2.9;
    import wasi:cli/terminal-stdout@0.2.9;
    import wasi:cli/terminal-stderr@0.2.9;
    import wasi:clocks/monotonic-clock@0.2.9;
    import wasi:clocks/wall-clock@0.2.9;

    // HTTP for LLM API calls and MCP communication
    import wasi:http/types@0.2.9;
    import wasi:http/outgoing-handler@0.2.9;

    // Filesystem for config, state, and file operations
    import wasi:filesystem/types@0.2.9;
    import wasi:filesystem/preopens@0.2.9;

    // Random for session IDs
    import wasi:random/random@0.2.9;
    import wasi:random/insecure-seed@0.2.9;

    // Shell execution — routes to host sandbox
    import shell-exec;

    // WebSocket — routes to browser native WebSocket API
    import websocket;

    // Terminal size for resize handling
    import terminal:info/size@0.1.0;

    // Browser actions — open URLs in new tabs
    import host:browser/actions@0.1.0;

    // Browser clipboard — read/write text via navigator.clipboard
    import host:browser/clipboard@0.1.0;

    // Console logging — route to browser console instead of stderr
    import host:console/logging@0.1.0;

    // Main entry point — runs the Codex TUI event loop
    export run: func() -> s32;

    // Push an OAuth callback request into the tiny_http channel so that
    // the login server's recv() loop can pick it up. Called by the JS host
    // when the browser receives an OAuth redirect.
    export push-auth-callback: func(method: string, path: string, headers: list<tuple<string, string>>, body: list<u8>);
}
