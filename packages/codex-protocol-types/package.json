{
    "name": "@tjfontaine/codex-protocol-types",
    "version": "0.1.0",
    "description": "TypeScript types generated from the codex app-server protocol (ts-rs)",
    "type": "module",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
