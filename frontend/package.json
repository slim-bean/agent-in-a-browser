{
    "name": "web-agent-frontend",
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "dev": "vite",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:ui": "playwright test --ui",
        "test:all": "pnpm run test && pnpm run test:e2e",
        "clean:wasm": "rm -rf src/wasm/mcp-server-jspi src/wasm/mcp-server-sync src/wasm/tsx-engine src/wasm/sqlite-module src/wasm/edtui-module src/wasm/codex-tui src/wasm/codex-tui-sync"
    },
    "dependencies": {
        "@tjfontaine/mcp-wasm-server": "workspace:*",
        "@tjfontaine/wasi-shims": "workspace:*",
        "@tjfontaine/wasm-loader": "workspace:*",
        "@tjfontaine/wasm-sqlite": "workspace:*",
        "@tjfontaine/wasm-tsx": "workspace:*",
        "@tjfontaine/wasm-stripe": "workspace:*",
        "stripe-cli-wasm": "workspace:*",
        "@tjfontaine/wasm-git": "workspace:*",
        "@tjfontaine/wasm-vim": "workspace:*",
        "@tjfontaine/wasm-python": "workspace:*",
        "@tjfontaine/codex-protocol-types": "workspace:*",
        "@tjfontaine/edge-agent-session": "workspace:*",
        "ghostty-web": "^0.4.0",
        "vite-plugin-node-polyfills": "^0.24.0"
    },
    "devDependencies": {
        "@bytecodealliance/jco": "^1.15.4",
        "@eslint/js": "^9.39.2",
        "@playwright/test": "^1.57.0",
        "@types/node": "^25.0.3",
        "@vitest/coverage-v8": "^4.0.16",
        "eslint": "^9.39.2",
        "jsdom": "^27.3.0",
        "typescript": "^5.7.2",
        "typescript-eslint": "^8.50.0",
        "vite": "^7.3.0",
        "vitest": "^4.0.16"
    }
}